<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- CSS: box-shadow 0 8px 20px rgba(98,70,255,.3) -->
    <item android:drawable="@drawable/shadow_fab" />
    <!-- CSS: 5px border in the page background colour -->
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/color_background" />
        </shape>
    </item>
    <item
        android:bottom="@dimen/_2sdp"
        android:left="@dimen/_2sdp"
        android:right="@dimen/_2sdp"
        android:top="@dimen/_2sdp">
        <shape android:shape="oval">
            <gradient
                android:angle="315"
                android:endColor="@color/color_gradient_end"
                android:startColor="@color/color_gradient_start" />
        </shape>
    </item>
</layer-list>
