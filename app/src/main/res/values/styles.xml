<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Text" parent="">
        <item name="android:fontFamily">@font/plus_jakarta_sans_regular</item>
        <item name="android:textColor">@color/color_text_primary</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="Text.Semibold" parent="Text">
        <item name="android:fontFamily">@font/plus_jakarta_sans_semibold</item>
    </style>
    <style name="Text.Display" parent="Text">
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_semibold</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>
    <style name="Text.Headline" parent="Text">
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_semibold</item>
    </style>
    <style name="Text.Title" parent="Text">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_semibold</item>
    </style>
    <style name="Text.Subtitle" parent="Text">
        <item name="android:textSize">@dimen/text_subtitle</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_semibold</item>
    </style>
    <style name="Text.Body" parent="Text">
        <item name="android:textSize">@dimen/text_body</item>
    </style>
    <style name="Text.BodyStrong" parent="Text.Body">
        <item name="android:fontFamily">@font/plus_jakarta_sans_semibold</item>
    </style>
    <style name="Text.Label" parent="Text">
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:textColor">@color/color_text_secondary</item>
    </style>
    <style name="Text.Caption" parent="Text">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/color_text_secondary</item>
    </style>
    <style name="Text.Section" parent="Text">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_semibold</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textColor">@color/color_text_tertiary</item>
    </style>
    <style name="Text.Error" parent="Text">
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:textColor">@color/color_error</item>
        <item name="android:drawablePadding">@dimen/_6sdp</item>
    </style>

    <!-- Buttons -->
    <style name="Button.Primary" parent="Text">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textSize">@dimen/_16sdp</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_semibold</item>
        <item name="android:drawablePadding">@dimen/_6sdp</item>
        <item name="android:paddingStart">@dimen/spacing_xl</item>
        <item name="android:paddingEnd">@dimen/spacing_xl</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="Button.Secondary" parent="Button.Primary">
        <item name="android:background">@drawable/bg_button_secondary</item>
    </style>
    <style name="Button.Danger" parent="Button.Primary">
        <item name="android:background">@drawable/bg_button_danger</item>
    </style>
    <style name="Button.Text" parent="Text">
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">@color/color_accent_light</item>
        <item name="android:textSize">@dimen/text_body_small</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_semibold</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Round icon buttons -->
    <style name="IconButton" parent="">
        <item name="android:layout_width">@dimen/back_button</item>
        <item name="android:layout_height">@dimen/back_button</item>
        <item name="android:padding">@dimen/_11sdp</item>
        <item name="android:background">@drawable/bg_icon_button</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="tint">@color/color_text_primary</item>
    </style>
    <style name="IconButton.Large">
        <item name="android:layout_width">@dimen/circle_button</item>
        <item name="android:layout_height">@dimen/circle_button</item>
        <item name="android:padding">@dimen/_14sdp</item>
    </style>
    <style name="IconButton.Plain" parent="">
        <item name="android:layout_width">@dimen/touch_target</item>
        <item name="android:layout_height">@dimen/touch_target</item>
        <item name="android:padding">@dimen/_10sdp</item>
        <item name="android:background">@drawable/bg_ripple_circle</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Chip" parent="Text">
        <item name="android:minHeight">@dimen/chip_height</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:textColor">@color/selector_chip_text</item>
        <item name="android:textSize">@dimen/text_body_small</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_semibold</item>
        <item name="android:drawablePadding">@dimen/_8sdp</item>
        <item name="android:paddingStart">@dimen/_14sdp</item>
        <item name="android:paddingEnd">@dimen/_12sdp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="ChipCount" parent="Text">
        <item name="android:minWidth">@dimen/_22sdp</item>
        <item name="android:minHeight">@dimen/_22sdp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_chip_count</item>
        <item name="android:textColor">@color/selector_chip_text</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:paddingStart">@dimen/_6sdp</item>
        <item name="android:paddingEnd">@dimen/_6sdp</item>
    </style>

    <style name="Input" parent="Text">
        <item name="android:background">@null</item>
        <item name="android:textColorHint">@color/color_text_hint</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:singleLine">true</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:importantForAutofill" tools:targetApi="26">no</item>
        <item name="android:textCursorDrawable">@drawable/cursor_accent</item>
    </style>
    <style name="OnbFloatCard" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">@drawable/bg_art_float</item>
        <item name="android:paddingStart">@dimen/_10sdp</item>
        <item name="android:paddingEnd">@dimen/_14sdp</item>
        <item name="android:paddingTop">@dimen/_10sdp</item>
        <item name="android:paddingBottom">@dimen/_10sdp</item>
    </style>
    <style name="OnbFloatTexts" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">@dimen/_10sdp</item>
        <item name="android:orientation">vertical</item>
    </style>
    <style name="OnbFloatName" parent="Text.Semibold">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/_13sdp</item>
    </style>
    <style name="OnbFloatCount" parent="Text">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/color_text_secondary</item>
        <item name="android:textSize">@dimen/_11sdp</item>
    </style>
    <style name="OnbFloatIcon" parent="">
        <item name="android:layout_width">@dimen/_34sdp</item>
        <item name="android:layout_height">@dimen/_34sdp</item>
        <item name="android:background">@drawable/bg_gradient_11</item>
        <item name="android:padding">@dimen/_7sdp</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="tint">@color/white</item>
    </style>
</resources>
