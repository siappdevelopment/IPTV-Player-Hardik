    <!-- Privacy policy -->
    <string name="privacy_title">Privacy Policy</string>
    <string name="privacy_updated">Last updated 1 October 2026</string>
    <string name="privacy_intro">IPTV Player is a media player. It doesn’t provide, host or sell any channels. You add your own playlists, and they stay on your device.</string>
    <string-array name="privacy_titles">
        <item>Information we collect</item>
        <item>Your playlists and streams</item>
        <item>Advertising</item>
        <item>Diagnostics</item>
        <item>Your choices</item>
        <item>Contact</item>
    </string-array>
    <string-array name="privacy_bodies">
        <item>We don’t ask for an account, name or email. The app stores your playlists, favorites, recent channels and settings locally on your device.</item>
        <item>Playlist links and M3U files you add are read only to show channels. Streams are played directly from the source you provide. We don’t upload or share them.</item>
        <item>This app shows no advertising and does not use a device advertising ID.</item>
        <item>This app does not send crash reports or analytics. Nothing about your playlists or channels leaves your device.</item>
        <item>Clear recent history in Settings, or uninstall the app to remove all stored data from your device.</item>
        <item>Questions about privacy? Email privacy@example.com.</item>
    </string-array>
    <array name="privacy_icons">
        <item>@drawable/ic_person</item>
        <item>@drawable/ic_playlist_play</item>
        <item>@drawable/ic_ads_click</item>
        <item>@drawable/ic_analytics</item>
        <item>@drawable/ic_tune</item>
        <item>@drawable/ic_mail</item>
    </array>
