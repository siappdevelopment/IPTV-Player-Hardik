<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Dark-only app (as designed). -->
    <style name="Base.Theme.IPTVSmartPlayerLiveTV" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:statusBarColor">@color/bg_color</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
        <item name="android:windowShowWallpaper">true</item>
        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorPrimaryVariant">@color/color_primary</item>
        <item name="colorSecondary">@color/color_primary</item>
        <item name="android:fitsSystemWindows">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <style name="Theme.IPTVSmartPlayerLiveTV" parent="Base.Theme.IPTVSmartPlayerLiveTV" />

    <style name="Theme.MyApp.Splash" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:fitsSystemWindows">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <style name="Theme.Launcher" parent="Base.Theme.IPTVSmartPlayerLiveTV">
        <item name="android:navigationBarColor">@android:color/white</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Base.Theme.MainActivityTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorPrimaryVariant">@color/color_primary</item>
        <item name="colorSecondary">@color/color_primary</item>
    </style>

    <style name="Theme.MainActivityTheme" parent="Base.Theme.MainActivityTheme">
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <style name="vardo_RatingBar" parent="Theme.AppCompat">
        <item name="colorControlNormal">#ADA1A1A1</item>
        <item name="colorControlActivated">#AD707070</item>
    </style>

    <style name="vardo_DialogAnimation">
        <item name="android:windowEnterAnimation">@anim/reso_anim_slide_in_right_view</item>
        <item name="android:windowExitAnimation">@anim/reso_anim_slide_out_right_view</item>
    </style>

</resources>