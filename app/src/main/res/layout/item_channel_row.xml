<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/_5sdp"
    android:layout_marginTop="@dimen/_4sdp"
    android:layout_marginEnd="@dimen/_5sdp"
    android:layout_marginBottom="@dimen/_4sdp"
    android:background="@drawable/bg_row"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="@dimen/_64sdp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/_8sdp"
    android:paddingTop="@dimen/_8sdp"
    android:paddingEnd="@dimen/_3sdp"
    android:paddingBottom="@dimen/_8sdp">

    <FrameLayout
        android:layout_width="@dimen/row_thumb_width"
        android:layout_height="@dimen/row_thumb_height">

        <com.iptvplayer.xtreamiptv.myiptvpro.IPTV.ui.common.ChannelThumbView
            android:id="@+id/thumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_thumb_12"
            app:logoPadding="@dimen/_5sdp"
            app:tileIconSize="@dimen/_17sdp"
            app:tileSize="@dimen/_26sdp" />

        <TextView
            android:id="@+id/tvQuality"
            style="@style/Text"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_14sdp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="@dimen/_4sdp"
            android:layout_marginBottom="@dimen/_4sdp"
            android:background="@drawable/bg_badge_small"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/_4sdp"
            android:paddingEnd="@dimen/_4sdp"
            android:textSize="@dimen/_8sdp"
            android:fontFamily="@font/plus_jakarta_sans_semibold" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_9sdp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvName"
            style="@style/Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="@dimen/_11sdp"
            android:fontFamily="@font/plus_jakarta_sans_semibold" />

        <TextView
            android:id="@+id/tvCategories"
            style="@style/Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_2sdp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="@dimen/_10sdp" />

        <TextView
            android:id="@+id/tvWatched"
            style="@style/Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_2sdp"
            android:drawableStart="@drawable/ic_history"
            android:drawablePadding="@dimen/_3sdp"
            android:drawableTint="@color/color_accent_light"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:textColor="@color/color_accent_light"
            android:visibility="gone" />
    </LinearLayout>

    <ImageView
        android:id="@+id/btnFavorite"
        style="@style/IconButton.Plain"
        android:contentDescription="@string/cd_favorite"
        android:padding="@dimen/_8sdp"
        android:src="@drawable/sel_favorite"
        app:tint="@color/selector_fav_tint" />

    <ImageView
        android:id="@+id/btnMore"
        style="@style/IconButton.Plain"
        android:contentDescription="@string/cd_more_actions"
        android:src="@drawable/ic_more_vert"
        app:tint="@color/color_text_soft" />
</LinearLayout>
