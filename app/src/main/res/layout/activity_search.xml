<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/searchRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/spacing_sm"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/spacing_sm">

        <ImageView
            android:id="@+id/btnBack"
            style="@style/IconButton"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_arrow_back" />

        <LinearLayout
            android:id="@+id/searchPill"
            android:layout_width="@dimen/_0sdp"
            android:layout_height="@dimen/circle_button"
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_weight="1"
            android:addStatesFromChildren="true"
            android:background="@drawable/bg_search_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/_16sdp"
            android:paddingEnd="@dimen/_4sdp">

            <ImageView
                android:layout_width="@dimen/_22sdp"
                android:layout_height="@dimen/_22sdp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_search"
                app:tint="@color/color_text_secondary" />

            <EditText
                android:id="@+id/etQuery"
                style="@style/Input"
                android:layout_width="@dimen/_0sdp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/_8sdp"
                android:layout_weight="1"
                android:hint="@string/search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text" />

            <ImageView
                android:id="@+id/btnClear"
                style="@style/IconButton.Plain"
                android:contentDescription="@string/cd_clear"
                android:src="@drawable/ic_cancel"
                android:visibility="gone"
                app:tint="@color/color_text_secondary" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvScope"
        style="@style/Text.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/_6sdp"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/spacing_md"
        android:textColor="@color/color_text_tertiary"
        android:textSize="@dimen/_12_5sdp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/_0sdp"
        android:layout_weight="1">

        <!-- before typing -->
        <LinearLayout
            android:id="@+id/sectionIdle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingEnd="@dimen/screen_padding">

            <TextView
                style="@style/Text.BodyStrong"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/search_try_category" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/groupSuggestions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                app:chipSpacingHorizontal="@dimen/_8sdp"
                app:chipSpacingVertical="@dimen/_8sdp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvResults"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="@dimen/screen_padding"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="@dimen/spacing_xl"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/sectionNoResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_80sdp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/_28sdp"
            android:paddingEnd="@dimen/_28sdp"
            android:visibility="gone">

            <ImageView
                android:layout_width="@dimen/_236sdp"
                android:layout_height="@dimen/_150sdp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_no_data" />

            <TextView
                android:id="@+id/tvNoResultsTitle"
                style="@style/Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_14sdp"
                android:gravity="center" />

            <TextView
                style="@style/Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:gravity="center"
                app:lineHeight="@dimen/_21sdp"
                android:maxWidth="@dimen/_260sdp"
                android:text="@string/search_no_results_desc"
                android:textColor="@color/color_text_secondary"
                android:textSize="@dimen/_14_5sdp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
