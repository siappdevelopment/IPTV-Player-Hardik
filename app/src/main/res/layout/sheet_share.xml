<?xml version="1.0" encoding="utf-8"?>
<!-- Design "Share the app": 28px top-rounded sheet, padding 12/20/30, 16 gaps. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:orientation="vertical"
    android:paddingStart="@dimen/_15sdp"
    android:paddingTop="@dimen/_9sdp"
    android:paddingEnd="@dimen/_15sdp"
    android:paddingBottom="@dimen/_23sdp">

    <View
        android:layout_width="@dimen/_31sdp"
        android:layout_height="@dimen/_3sdp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_handle" />

    <TextView
        style="@style/Text.Semibold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_12sdp"
        android:text="@string/share_title"
        android:textSize="@dimen/_15sdp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_12sdp"
        android:background="@drawable/bg_share_link_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/_9sdp">

        <FrameLayout
            android:layout_width="@dimen/_37sdp"
            android:layout_height="@dimen/_37sdp"
            android:background="@drawable/bg_gradient_tile_15">

            <ImageView
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_live_tv"
                app:tint="@color/white" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_9sdp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Text.Semibold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/share_card_title"
                android:textSize="@dimen/_11sdp" />

            <TextView
                android:id="@+id/tvLink"
                style="@style/Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/color_text_secondary"
                android:textSize="@dimen/_10sdp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnCopy"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_40sdp"
        android:layout_marginTop="@dimen/_12sdp"
        android:background="@drawable/bg_tile_high_16"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivCopy"
            android:layout_width="@dimen/_15sdp"
            android:layout_height="@dimen/_15sdp"
            android:layout_marginEnd="@dimen/_6sdp"
            android:importantForAccessibility="no"
            app:tint="@color/color_accent_light" />

        <TextView
            android:id="@+id/tvCopy"
            style="@style/Text.Semibold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/share_copy_link"
            android:textSize="@dimen/_11sdp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_12sdp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <include
            android:id="@+id/targetMessages"
            layout="@layout/item_share_target" />

        <include
            android:id="@+id/targetEmail"
            layout="@layout/item_share_target" />

        <include
            android:id="@+id/targetBluetooth"
            layout="@layout/item_share_target" />

        <include
            android:id="@+id/targetMore"
            layout="@layout/item_share_target" />
    </LinearLayout>
</LinearLayout>
