<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ll_native_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_alignParentBottom="true"
    android:background="@drawable/reso_ads_main_bg"
    android:orientation="vertical"
    android:paddingLeft="5dp"
    android:paddingTop="5dp"
    android:paddingRight="5dp"
    android:paddingBottom="5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="3dp"
            android:visibility="visible">

            <ImageView
                android:id="@+id/reso__iv_banner_round"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:adjustViewBounds="true" />

        </RelativeLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">


                <TextView
                    android:id="@+id/txt_tag_AD"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/reso_ad_view"
                    android:paddingHorizontal="@dimen/_3sdp"
                    android:paddingVertical="3dp"
                    android:text="Ad"
                    android:fontFamily="@font/plus_jakarta_sans_medium"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_8sdp" />

                <TextView
                    android:id="@+id/reso__tv_text_ad_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:ellipsize="end"
                    android:fontFamily="@font/plus_jakarta_sans_medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="🏡 Home Loan: Own Your Dream"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_12sdp" />

            </LinearLayout>


            <TextView
                android:id="@+id/reso__tv_text_ad_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_3sdp"
                android:ellipsize="end"
                android:fontFamily="@font/plus_jakarta_sans_regular"
                android:maxLines="1"
                android:text="💸 Get the keys to your dream home with easy repayment options and competitive interest rates."
                android:textColor="@color/gray_color"
                android:textSize="@dimen/_10sdp" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/reso__btnInsatll"
            android:layout_width="wrap_content"
            android:layout_height="37dp"
            android:layout_margin="4dp"
            android:background="@drawable/bg_button_primary"
            android:lines="1"
            android:includeFontPadding="false"
            android:paddingHorizontal="@dimen/_5sdp"
            android:text="Click"
            android:fontFamily="@font/plus_jakarta_sans_medium"
            android:textColor="#ffffff"
            android:textSize="@dimen/_10sdp" />

    </LinearLayout>

</LinearLayout>


