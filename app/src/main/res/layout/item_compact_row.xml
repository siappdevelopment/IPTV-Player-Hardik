<?xml version="1.0" encoding="utf-8"?>
<!-- Used by the player's channel list and by search results. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="@dimen/_55sdp"
    android:layout_marginTop="@dimen/_4sdp"
    android:layout_marginBottom="@dimen/_4sdp"
    android:background="@drawable/bg_row_select"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/_9sdp"
    android:paddingEnd="@dimen/_5sdp">

    <com.iptvplayer.xtreamiptv.myiptvpro.IPTV.ui.common.ChannelThumbView
        android:id="@+id/thumb"
        android:layout_width="@dimen/player_row_thumb_width"
        android:layout_height="@dimen/player_row_thumb_height"
        android:background="@drawable/bg_thumb_11"
        app:logoPadding="@dimen/_3sdp"
        app:tileIconSize="@dimen/_17sdp"
        app:tileSize="@dimen/_23sdp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_9sdp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvName"
            style="@style/Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="@dimen/_11sdp"
            android:fontFamily="@font/plus_jakarta_sans_semibold" />

        <TextView
            android:id="@+id/tvCategories"
            style="@style/Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_2sdp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="@dimen/_10sdp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/ivActive"
        android:layout_width="@dimen/_17sdp"
        android:layout_height="@dimen/_17sdp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_graphic_eq"
        android:visibility="gone"
        app:tint="@color/color_accent_light" />

    <ImageView
        android:id="@+id/btnFavorite"
        style="@style/IconButton.Plain"
        android:contentDescription="@string/cd_favorite"
        android:padding="@dimen/_7sdp"
        android:src="@drawable/sel_favorite"
        app:tint="@color/selector_fav_tint" />
</LinearLayout>
