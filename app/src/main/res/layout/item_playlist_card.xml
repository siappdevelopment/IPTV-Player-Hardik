<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/_5sdp"
    android:background="@drawable/bg_card"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/_76sdp"
        android:layout_marginStart="@dimen/_5sdp"
        android:layout_marginTop="@dimen/_5sdp"
        android:layout_marginEnd="@dimen/_5sdp"
        android:background="@drawable/bg_thumb_17"
        android:clipToOutline="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <com.iptvplayer.xtreamiptv.myiptvpro.IPTV.ui.common.ChannelThumbView
                android:id="@+id/thumb1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:tileIconSize="@dimen/_18sdp"
                app:tileSize="@dimen/_31sdp" />

            <View
                android:layout_width="@dimen/_2sdp"
                android:layout_height="match_parent"
                android:background="@color/color_background" />

            <com.iptvplayer.xtreamiptv.myiptvpro.IPTV.ui.common.ChannelThumbView
                android:id="@+id/thumb2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:tileIconSize="@dimen/_18sdp"
                app:tileSize="@dimen/_31sdp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_scrim_card" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_27sdp"
            android:layout_gravity="top|end"
            android:layout_margin="@dimen/_5sdp"
            android:background="@drawable/bg_badge"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/_2sdp"
            android:paddingEnd="@dimen/_2sdp">

            <ImageView
                android:id="@+id/btnEdit"
                android:layout_width="@dimen/_26sdp"
                android:layout_height="@dimen/_26sdp"
                android:background="@drawable/bg_ripple_circle"
                android:contentDescription="@string/cd_edit_playlist"
                android:padding="@dimen/_6sdp"
                android:src="@drawable/ic_edit"
                app:tint="@color/white" />

            <View
                android:layout_width="@dimen/_1sdp"
                android:layout_height="@dimen/_12sdp"
                android:background="@color/color_handle" />

            <ImageView
                android:id="@+id/btnDelete"
                android:layout_width="@dimen/_26sdp"
                android:layout_height="@dimen/_26sdp"
                android:background="@drawable/bg_ripple_circle"
                android:contentDescription="@string/cd_delete_playlist"
                android:padding="@dimen/_6sdp"
                android:src="@drawable/ic_delete"
                app:tint="@color/color_error_soft" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="@dimen/_29sdp"
            android:layout_height="@dimen/_29sdp"
            android:layout_gravity="bottom|start"
            android:layout_margin="@dimen/_6sdp"
            android:background="@drawable/bg_gradient_12_shadow">

            <ImageView
                android:id="@+id/ivIcon"
                android:layout_width="@dimen/_16sdp"
                android:layout_height="@dimen/_16sdp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_video_library"
                app:tint="@color/white" />
        </FrameLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/_11sdp"
        android:paddingTop="@dimen/_9sdp"
        android:paddingEnd="@dimen/_9sdp"
        android:paddingBottom="@dimen/_11sdp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvName"
                style="@style/Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="@dimen/_12sdp"
                android:fontFamily="@font/plus_jakarta_sans_semibold" />

            <TextView
                android:id="@+id/tvCount"
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:maxLines="1"
                android:textSize="@dimen/_10sdp" />

            <TextView
                android:id="@+id/tvSource"
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_3sdp"
                android:drawablePadding="@dimen/_3sdp"
                android:drawableTint="@color/color_accent_light"
                android:gravity="center_vertical"
                android:textColor="@color/color_accent_light"
                android:textSize="@dimen/_9sdp" />
        </LinearLayout>

        <ImageView
            android:layout_width="@dimen/_27sdp"
            android:layout_height="@dimen/_27sdp"
            android:layout_marginStart="@dimen/_6sdp"
            android:background="@drawable/bg_tile_high_14"
            android:importantForAccessibility="no"
            android:padding="@dimen/_5sdp"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/color_text_primary" />
    </LinearLayout>
</LinearLayout>
