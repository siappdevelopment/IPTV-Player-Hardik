<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/detailsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/spacing_sm"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/spacing_lg">

        <ImageView
            android:id="@+id/btnBack"
            style="@style/IconButton"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_arrow_back" />

        <LinearLayout
            android:layout_width="@dimen/_0sdp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_12sdp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTitle"
                style="@style/Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1" />

            <TextView
                android:id="@+id/tvSub"
                style="@style/Text.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:ellipsize="end"
                android:maxLines="1" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnSearch"
            style="@style/IconButton"
            android:layout_width="@dimen/_48sdp"
            android:layout_height="@dimen/_48sdp"
            android:layout_marginStart="@dimen/_12sdp"
            android:contentDescription="@string/cd_search"
            android:src="@drawable/ic_search" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/sectionRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/spacing_md">

        <TextView
            style="@style/Text.Subtitle"
            android:layout_width="@dimen/_0sdp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/details_channels" />

        <include
            android:id="@+id/viewToggle"
            layout="@layout/view_view_toggle" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/_0sdp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvChannels"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="@dimen/_14sdp"
            android:paddingEnd="@dimen/_14sdp"
            android:paddingBottom="@dimen/spacing_xl" />

        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginTop="@dimen/_60sdp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/_28sdp"
            android:paddingEnd="@dimen/_28sdp"
            android:visibility="gone">

            <ImageView
                android:layout_width="@dimen/_236sdp"
                android:layout_height="@dimen/_150sdp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_no_data" />

            <TextView
                style="@style/Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="@string/details_empty_title" />

            <TextView
                style="@style/Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:gravity="center"
                android:text="@string/details_empty_desc"
                android:textColor="@color/color_text_secondary"
                android:textSize="@dimen/_14_5sdp" />

            <com.iptvplayer.xtreamiptv.myiptvpro.ui.common.IconTextView
                android:id="@+id/btnEmptyAdd"
                style="@style/Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_52sdp"
                android:layout_marginTop="@dimen/spacing_lg"
                android:drawableEnd="@drawable/ic_add"
                android:drawableTint="@color/white"
                android:minHeight="@dimen/_52sdp"
                android:text="@string/details_empty_cta"
                android:textSize="@dimen/_15sdp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
