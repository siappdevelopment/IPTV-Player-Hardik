<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/onboardingRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:orientation="vertical">

    <!-- art area: 470 high, clipped, with the violet radial glow -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/_470sdp"
        android:background="@drawable/bg_splash_glow"
        android:clipChildren="true">

        <FrameLayout
            android:id="@+id/artFrame"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <include
                android:id="@+id/art1"
                layout="@layout/onb_art_1" />

            <include
                android:id="@+id/art2"
                layout="@layout/onb_art_2" />

            <include
                android:id="@+id/art3"
                layout="@layout/onb_art_3" />

            <include
                android:id="@+id/art4"
                layout="@layout/onb_art_4" />
        </FrameLayout>

        <TextView
            android:id="@+id/btnSkip"
            style="@style/Text.Semibold"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_40sdp"
            android:layout_gravity="top|end"
            android:layout_marginTop="@dimen/_8sdp"
            android:layout_marginEnd="@dimen/_16sdp"
            android:background="@drawable/bg_search_pill_button_20"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="@dimen/_16sdp"
            android:paddingEnd="@dimen/_16sdp"
            android:text="@string/action_skip"
            android:textColor="@color/color_text_soft"
            android:textSize="@dimen/_14sdp" />
    </FrameLayout>

    <!-- title / subtitle top, dots + button anchored to the bottom (padding 12 / 24 / 20) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/_0sdp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="@dimen/_24sdp"
        android:paddingTop="@dimen/_12sdp"
        android:paddingEnd="@dimen/_24sdp"
        android:paddingBottom="@dimen/_20sdp">

        <TextView
            android:id="@+id/tvTitle"
            style="@style/Text.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:lineHeight="@dimen/_32sdp" />

        <TextView
            android:id="@+id/tvSub"
            style="@style/Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_12sdp"
            android:textColor="@color/color_text_secondary"
            android:textSize="@dimen/_16sdp"
            app:lineHeight="@dimen/_24sdp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/_0sdp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/dots"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_8sdp"
            android:layout_marginBottom="@dimen/_20sdp"
            android:orientation="horizontal" />

        <com.iptvplayer.xtreamiptv.myiptvpro.ui.common.IconTextView
            android:id="@+id/btnNext"
            app:iconSize="@dimen/_20sdp"
            style="@style/Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_56sdp"
            android:drawableEnd="@drawable/ic_arrow_forward"
            android:drawableTint="@color/white"
            android:text="@string/action_next" />
    </LinearLayout>
</LinearLayout>
