<?xml version="1.0" encoding="utf-8"?>
<!-- Portrait overlay on top of the 16:9 video. Same ids as layout-land/view_player_overlay. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/dim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#59000000" />

    <FrameLayout
        android:id="@+id/layoutControls"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:id="@+id/badgeLive"
            style="@style/Text"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_28sdp"
            android:layout_marginStart="@dimen/_12sdp"
            android:layout_marginTop="@dimen/_12sdp"
            android:background="@drawable/bg_badge"
            android:drawableStart="@drawable/bg_dot_live"
            android:drawablePadding="@dimen/_6sdp"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/_10sdp"
            android:paddingEnd="@dimen/_10sdp"
            android:text="@string/label_live"
            android:textSize="@dimen/_12sdp"
            android:fontFamily="@font/plus_jakarta_sans_semibold" />

        <ImageView
            android:id="@+id/btnFavorite"
            android:layout_width="@dimen/_44sdp"
            android:layout_height="@dimen/_44sdp"
            android:layout_gravity="top|end"
            android:layout_marginTop="@dimen/_8sdp"
            android:layout_marginEnd="@dimen/_10sdp"
            android:background="@drawable/bg_ripple_circle"
            android:contentDescription="@string/cd_favorite"
            android:padding="@dimen/_9sdp"
            android:src="@drawable/sel_favorite"
            app:tint="@color/selector_fav_tint" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnPrev"
                android:layout_width="@dimen/_48sdp"
                android:layout_height="@dimen/_48sdp"
                android:background="@drawable/bg_circle_control"
                android:contentDescription="@string/cd_previous"
                android:padding="@dimen/_9sdp"
                android:src="@drawable/ic_skip_previous"
                app:tint="@color/white" />

            <ImageView
                android:id="@+id/btnPlayPause"
                android:layout_width="@dimen/_64sdp"
                android:layout_height="@dimen/_64sdp"
                android:layout_marginStart="@dimen/_28sdp"
                android:layout_marginEnd="@dimen/_28sdp"
                android:background="@drawable/bg_circle_play"
                android:contentDescription="@string/cd_play_pause"
                android:padding="@dimen/_13sdp"
                android:src="@drawable/ic_pause"
                app:tint="@color/white" />

            <ImageView
                android:id="@+id/btnNext"
                android:layout_width="@dimen/_48sdp"
                android:layout_height="@dimen/_48sdp"
                android:background="@drawable/bg_circle_control"
                android:contentDescription="@string/cd_next"
                android:padding="@dimen/_9sdp"
                android:src="@drawable/ic_skip_next"
                app:tint="@color/white" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnLock"
            android:layout_width="@dimen/_44sdp"
            android:layout_height="@dimen/_44sdp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="@dimen/_8sdp"
            android:layout_marginBottom="@dimen/_6sdp"
            android:background="@drawable/bg_ripple_circle"
            android:contentDescription="@string/cd_lock"
            android:padding="@dimen/_10sdp"
            android:src="@drawable/ic_lock_open"
            app:tint="@color/white" />

        <ImageView
            android:id="@+id/btnFullscreen"
            android:layout_width="@dimen/_44sdp"
            android:layout_height="@dimen/_44sdp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="@dimen/_8sdp"
            android:layout_marginBottom="@dimen/_6sdp"
            android:background="@drawable/bg_ripple_circle"
            android:contentDescription="@string/cd_fullscreen"
            android:padding="@dimen/_9sdp"
            android:src="@drawable/ic_fullscreen"
            app:tint="@color/white" />
    </FrameLayout>

    <com.iptvplayer.xtreamiptv.myiptvpro.ui.common.IconTextView
        android:id="@+id/btnUnlock"
        style="@style/Text"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/_44sdp"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="@dimen/_12sdp"
        android:background="@drawable/bg_glass_pill"
        android:clickable="true"
        android:drawableStart="@drawable/ic_lock"
        android:drawablePadding="@dimen/_8sdp"
        android:drawableTint="@color/white"
        android:focusable="true"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/_10sdp"
        android:paddingEnd="@dimen/_14sdp"
        android:text="@string/player_tap_unlock"
        android:textSize="@dimen/_13sdp"
        android:fontFamily="@font/plus_jakarta_sans_semibold"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/layoutLoading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#8C05060C"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="@dimen/_38sdp"
            android:layout_height="@dimen/_38sdp"
            android:indeterminateTint="@color/color_primary" />

        <TextView
            android:id="@+id/tvLoading"
            style="@style/Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_12sdp"
            android:textColor="@color/color_text_soft"
            android:textSize="@dimen/_13sdp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutError"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E005060C"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="@dimen/_40sdp"
        android:paddingEnd="@dimen/_40sdp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ivErrorIcon"
            android:layout_width="@dimen/_30sdp"
            android:layout_height="@dimen/_30sdp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_tv_off"
            app:tint="@color/color_error" />

        <TextView
            android:id="@+id/tvErrorTitle"
            style="@style/Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_6sdp"
            android:textSize="@dimen/_16sdp"
            android:fontFamily="@font/plus_jakarta_sans_semibold" />

        <TextView
            android:id="@+id/tvErrorDesc"
            style="@style/Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_6sdp"
            android:gravity="center"
            app:lineHeight="@dimen/_17_5sdp"
            android:textSize="@dimen/_12_5sdp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnErrorPrev"
                android:layout_width="@dimen/_40sdp"
                android:layout_height="@dimen/_40sdp"
                android:background="@drawable/bg_tile_raised_12"
                android:contentDescription="@string/cd_previous"
                android:padding="@dimen/_9sdp"
                android:src="@drawable/ic_skip_previous"
                app:tint="@color/white" />

            <com.iptvplayer.xtreamiptv.myiptvpro.ui.common.IconTextView
                android:id="@+id/btnRetry"
                style="@style/Text"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_40sdp"
                android:layout_marginStart="@dimen/_8sdp"
                android:layout_marginEnd="@dimen/_8sdp"
                android:background="@drawable/bg_gradient_12"
                android:clickable="true"
                android:drawableStart="@drawable/ic_refresh"
                android:drawablePadding="@dimen/_6sdp"
                android:drawableTint="@color/white"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/_14sdp"
                android:paddingEnd="@dimen/_18sdp"
                android:text="@string/action_retry"
                android:textSize="@dimen/_14sdp"
                android:fontFamily="@font/plus_jakarta_sans_semibold" />

            <ImageView
                android:id="@+id/btnErrorNext"
                android:layout_width="@dimen/_40sdp"
                android:layout_height="@dimen/_40sdp"
                android:background="@drawable/bg_tile_raised_12"
                android:contentDescription="@string/cd_next"
                android:padding="@dimen/_9sdp"
                android:src="@drawable/ic_skip_next"
                app:tint="@color/white" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
