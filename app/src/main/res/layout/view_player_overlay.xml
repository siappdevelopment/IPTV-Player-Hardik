<?xml version="1.0" encoding="utf-8"?>
<!-- Portrait overlay on top of the 16:9 video. Same ids as layout-land/view_player_overlay. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/dim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#59000000" />

    <FrameLayout
        android:id="@+id/layoutControls"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:id="@+id/badgeLive"
            style="@style/Text"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_21sdp"
            android:layout_marginStart="@dimen/_9sdp"
            android:layout_marginTop="@dimen/_9sdp"
            android:background="@drawable/bg_badge"
            android:drawableStart="@drawable/bg_dot_live"
            android:drawablePadding="@dimen/_5sdp"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/_8sdp"
            android:paddingEnd="@dimen/_8sdp"
            android:text="@string/label_live"
            android:textSize="@dimen/_9sdp"
            android:fontFamily="@font/plus_jakarta_sans_semibold" />

        <ImageView
            android:id="@+id/btnFavorite"
            android:layout_width="@dimen/_34sdp"
            android:layout_height="@dimen/_34sdp"
            android:layout_gravity="top|end"
            android:layout_marginTop="@dimen/_6sdp"
            android:layout_marginEnd="@dimen/_8sdp"
            android:background="@drawable/bg_ripple_circle"
            android:contentDescription="@string/cd_favorite"
            android:padding="@dimen/_7sdp"
            android:src="@drawable/sel_favorite"
            app:tint="@color/selector_fav_tint" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnPrev"
                android:layout_width="@dimen/_37sdp"
                android:layout_height="@dimen/_37sdp"
                android:background="@drawable/bg_circle_control"
                android:contentDescription="@string/cd_previous"
                android:padding="@dimen/_7sdp"
                android:src="@drawable/ic_skip_previous"
                app:tint="@color/white" />

            <ImageView
                android:id="@+id/btnPlayPause"
                android:layout_width="@dimen/_49sdp"
                android:layout_height="@dimen/_49sdp"
                android:layout_marginStart="@dimen/_21sdp"
                android:layout_marginEnd="@dimen/_21sdp"
                android:background="@drawable/bg_circle_play"
                android:contentDescription="@string/cd_play_pause"
                android:padding="@dimen/_10sdp"
                android:src="@drawable/ic_pause"
                app:tint="@color/white" />

            <ImageView
                android:id="@+id/btnNext"
                android:layout_width="@dimen/_37sdp"
                android:layout_height="@dimen/_37sdp"
                android:background="@drawable/bg_circle_control"
                android:contentDescription="@string/cd_next"
                android:padding="@dimen/_7sdp"
                android:src="@drawable/ic_skip_next"
                app:tint="@color/white" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnLock"
            android:layout_width="@dimen/_34sdp"
            android:layout_height="@dimen/_34sdp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="@dimen/_6sdp"
            android:layout_marginBottom="@dimen/_5sdp"
            android:background="@drawable/bg_ripple_circle"
            android:contentDescription="@string/cd_lock"
            android:padding="@dimen/_8sdp"
            android:src="@drawable/ic_lock_open"
            app:tint="@color/white" />

        <ImageView
            android:id="@+id/btnFullscreen"
            android:layout_width="@dimen/_34sdp"
            android:layout_height="@dimen/_34sdp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="@dimen/_6sdp"
            android:layout_marginBottom="@dimen/_5sdp"
            android:background="@drawable/bg_ripple_circle"
            android:contentDescription="@string/cd_fullscreen"
            android:padding="@dimen/_7sdp"
            android:src="@drawable/ic_fullscreen"
            app:tint="@color/white" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/btnUnlock"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/_34sdp"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="@dimen/_9sdp"
        android:background="@drawable/bg_glass_pill"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/_8sdp"
        android:paddingEnd="@dimen/_11sdp"
        android:visibility="gone">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/_6sdp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_lock"
            app:tint="@color/white" />

        <TextView
            style="@style/Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/plus_jakarta_sans_semibold"
            android:text="@string/player_tap_unlock"
            android:textSize="@dimen/_10sdp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutLoading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#8C05060C"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="@dimen/_29sdp"
            android:layout_height="@dimen/_29sdp"
            android:indeterminateTint="@color/color_primary" />

        <TextView
            android:id="@+id/tvLoading"
            style="@style/Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_9sdp"
            android:textColor="@color/color_text_soft"
            android:textSize="@dimen/_10sdp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutError"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E005060C"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="@dimen/_31sdp"
        android:paddingEnd="@dimen/_31sdp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ivErrorIcon"
            android:layout_width="@dimen/_23sdp"
            android:layout_height="@dimen/_23sdp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_tv_off"
            app:tint="@color/color_error" />

        <TextView
            android:id="@+id/tvErrorTitle"
            style="@style/Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp"
            android:textSize="@dimen/_12sdp"
            android:fontFamily="@font/plus_jakarta_sans_semibold" />

        <TextView
            android:id="@+id/tvErrorDesc"
            style="@style/Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp"
            android:gravity="center"
            app:lineHeight="@dimen/_13sdp"
            android:textSize="@dimen/_10sdp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_6sdp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnErrorPrev"
                android:layout_width="@dimen/_31sdp"
                android:layout_height="@dimen/_31sdp"
                android:background="@drawable/bg_tile_raised_12"
                android:contentDescription="@string/cd_previous"
                android:padding="@dimen/_7sdp"
                android:src="@drawable/ic_skip_previous"
                app:tint="@color/white" />

            <LinearLayout
                android:id="@+id/btnRetry"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_31sdp"
                android:layout_marginStart="@dimen/_6sdp"
                android:layout_marginEnd="@dimen/_6sdp"
                android:background="@drawable/bg_gradient_12"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="@dimen/_11sdp"
                android:paddingEnd="@dimen/_11sdp">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/_5sdp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_refresh"
                    app:tint="@color/white" />

                <TextView
                    style="@style/Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans_semibold"
                    android:text="@string/action_retry"
                    android:textSize="@dimen/_11sdp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnErrorNext"
                android:layout_width="@dimen/_31sdp"
                android:layout_height="@dimen/_31sdp"
                android:background="@drawable/bg_tile_raised_12"
                android:contentDescription="@string/cd_next"
                android:padding="@dimen/_7sdp"
                android:src="@drawable/ic_skip_next"
                app:tint="@color/white" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
