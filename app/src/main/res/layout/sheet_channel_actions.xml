<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:orientation="vertical"
    android:paddingStart="@dimen/_20sdp"
    android:paddingTop="@dimen/_12sdp"
    android:paddingEnd="@dimen/_20sdp"
    android:paddingBottom="@dimen/_28sdp">

    <View
        android:layout_width="@dimen/_40sdp"
        android:layout_height="@dimen/_4sdp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/_14sdp"
        android:background="@drawable/bg_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_md"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.iptvplayer.xtreamiptv.myiptvpro.ui.common.ChannelThumbView
            android:id="@+id/thumb"
            android:layout_width="@dimen/_84sdp"
            android:layout_height="@dimen/_48sdp"
            android:background="@drawable/bg_thumb_12"
            app:logoPadding="@dimen/_4sdp"
            app:tileIconSize="@dimen/_22sdp"
            app:tileSize="@dimen/_30sdp" />

        <LinearLayout
            android:layout_width="@dimen/_0sdp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvName"
                style="@style/Text.Subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1" />

            <TextView
                android:id="@+id/tvCategories"
                style="@style/Text.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:ellipsize="end"
                android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/actionFavorite"
        style="@style/Text.BodyStrong"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_56sdp"
        android:layout_marginTop="@dimen/spacing_sm"
        android:background="@drawable/bg_action_row"
        android:clickable="true"
        android:drawableStart="@drawable/ic_favorite_border"
        android:drawablePadding="@dimen/_14sdp"
        android:focusable="true"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/_14sdp"
        android:paddingEnd="@dimen/_14sdp" />

    <TextView
        android:id="@+id/actionEdit"
        style="@style/Text.BodyStrong"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_56sdp"
        android:layout_marginTop="@dimen/spacing_sm"
        android:background="@drawable/bg_action_row"
        android:clickable="true"
        android:drawableStart="@drawable/ic_edit"
        android:drawablePadding="@dimen/_14sdp"
        android:drawableTint="@color/color_accent_light"
        android:focusable="true"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/_14sdp"
        android:paddingEnd="@dimen/_14sdp"
        android:text="@string/action_edit_channel" />

    <TextView
        android:id="@+id/actionRemoveRecent"
        style="@style/Text.BodyStrong"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_56sdp"
        android:layout_marginTop="@dimen/spacing_sm"
        android:background="@drawable/bg_action_row"
        android:clickable="true"
        android:drawableStart="@drawable/ic_history_toggle_off"
        android:drawablePadding="@dimen/_14sdp"
        android:drawableTint="@color/color_accent_light"
        android:focusable="true"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/_14sdp"
        android:paddingEnd="@dimen/_14sdp"
        android:text="@string/action_remove_recent"
        android:visibility="gone" />

    <TextView
        android:id="@+id/actionDelete"
        style="@style/Text.BodyStrong"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_56sdp"
        android:layout_marginTop="@dimen/spacing_sm"
        android:background="@drawable/bg_action_row_danger"
        android:clickable="true"
        android:drawableStart="@drawable/ic_delete"
        android:drawablePadding="@dimen/_14sdp"
        android:drawableTint="@color/color_error"
        android:focusable="true"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/_14sdp"
        android:paddingEnd="@dimen/_14sdp"
        android:text="@string/action_delete_channel"
        android:textColor="@color/color_error_soft" />
</LinearLayout>
