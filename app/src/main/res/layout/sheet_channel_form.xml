<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:fillViewport="false"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/_20sdp"
        android:paddingTop="@dimen/_12sdp"
        android:paddingEnd="@dimen/_20sdp"
        android:paddingBottom="@dimen/_28sdp">

        <View
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_4sdp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_handle" />

        <TextView
            android:id="@+id/tvTitle"
            style="@style/Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg" />

        <!-- name -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:orientation="horizontal">

            <TextView
                style="@style/Text.BodyStrong"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/form_channel_name"
                android:textSize="@dimen/_14sdp" />

            <TextView
                style="@style/Text.BodyStrong"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_4sdp"
                android:text="*"
                android:textColor="@color/color_error"
                android:textSize="@dimen/_14sdp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/fieldName"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_54sdp"
            android:layout_marginTop="@dimen/spacing_sm"
            android:addStatesFromChildren="true"
            android:background="@drawable/bg_input_deep">

            <EditText
                android:id="@+id/etName"
                style="@style/Input"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="@string/form_channel_name_hint"
                android:inputType="textCapWords"
                android:paddingStart="@dimen/_16sdp"
                android:paddingEnd="@dimen/_16sdp" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvNameError"
            style="@style/Text.Error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_6sdp"
            android:visibility="gone" />

        <!-- url -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:orientation="horizontal">

            <TextView
                style="@style/Text.BodyStrong"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/form_stream_url"
                android:textSize="@dimen/_14sdp" />

            <TextView
                style="@style/Text.BodyStrong"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_4sdp"
                android:text="*"
                android:textColor="@color/color_error"
                android:textSize="@dimen/_14sdp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/fieldUrl"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_54sdp"
            android:layout_marginTop="@dimen/spacing_sm"
            android:addStatesFromChildren="true"
            android:background="@drawable/bg_input_deep">

            <EditText
                android:id="@+id/etUrl"
                style="@style/Input"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="@string/form_stream_url_hint"
                android:inputType="textUri"
                android:paddingStart="@dimen/_16sdp"
                android:paddingEnd="@dimen/_16sdp" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvUrlError"
            style="@style/Text.Error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_6sdp"
            android:visibility="gone" />

        <!-- category -->
        <TextView
            style="@style/Text.BodyStrong"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:text="@string/form_category"
            android:textSize="@dimen/_14sdp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/groupCategories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            app:chipSpacingHorizontal="@dimen/_8sdp"
            app:chipSpacingVertical="@dimen/_8sdp" />

        <!-- playlist (add only) -->
        <LinearLayout
            android:id="@+id/sectionPlaylists"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:orientation="vertical">

            <TextView
                style="@style/Text.BodyStrong"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/form_add_to_playlist"
                android:textSize="@dimen/_14sdp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/groupPlaylists"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                app:chipSpacingHorizontal="@dimen/_8sdp"
                app:chipSpacingVertical="@dimen/_8sdp" />
        </LinearLayout>

        <!-- logo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:orientation="horizontal">

            <TextView
                style="@style/Text.BodyStrong"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/form_logo"
                android:textSize="@dimen/_14sdp" />

            <TextView
                style="@style/Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_6sdp"
                android:text="@string/form_optional"
                android:textColor="@color/color_text_tertiary"
                android:textSize="@dimen/_14sdp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.iptvplayer.xtreamiptv.myiptvpro.ui.common.ChannelThumbView
                android:id="@+id/thumbLogo"
                android:layout_width="@dimen/_84sdp"
                android:layout_height="@dimen/_48sdp"
                android:background="@drawable/bg_thumb_12"
                app:logoPadding="@dimen/_4sdp"
                app:tileIconSize="@dimen/_22sdp"
                app:tileSize="@dimen/_30sdp" />

            <TextView
                android:id="@+id/btnChooseLogo"
                style="@style/Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_44sdp"
                android:layout_marginStart="@dimen/_12sdp"
                android:minHeight="@dimen/_44sdp"
                android:paddingStart="@dimen/_16sdp"
                android:paddingEnd="@dimen/_16sdp"
                android:text="@string/form_choose_image"
                android:textSize="@dimen/_14sdp" />

            <TextView
                android:id="@+id/btnRemoveLogo"
                style="@style/Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_44sdp"
                android:paddingStart="@dimen/_8sdp"
                android:paddingEnd="@dimen/_8sdp"
                android:text="@string/form_remove"
                android:textColor="@color/color_text_secondary"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xl"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnCancel"
                style="@style/Button.Secondary"
                android:layout_width="@dimen/_0sdp"
                android:layout_height="@dimen/_54sdp"
                android:layout_weight="1"
                android:minHeight="@dimen/_54sdp"
                android:text="@string/action_cancel" />

            <TextView
                android:id="@+id/btnSave"
                style="@style/Button.Primary"
                android:layout_width="@dimen/_0sdp"
                android:layout_height="@dimen/_54sdp"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_weight="1.4"
                android:minHeight="@dimen/_54sdp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
