<?xml version="1.0" encoding="utf-8"?>
<!-- Inflated by ChannelThumbView: gradient base (from the host's background), placeholder, logo, top scrim. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:id="@+id/thumbPlaceholder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/thumbPlaceholderTile"
            android:layout_width="@dimen/_46sdp"
            android:layout_height="@dimen/_46sdp"
            android:background="@drawable/bg_thumb_icon_tile">

            <ImageView
                android:id="@+id/thumbPlaceholderIcon"
                android:layout_width="@dimen/_26sdp"
                android:layout_height="@dimen/_26sdp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_live_tv"
                app:tint="@color/color_thumb_icon" />
        </FrameLayout>

        <TextView
            android:id="@+id/thumbCaption"
            style="@style/Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:letterSpacing="0.06"
            android:text="@string/thumb_no_preview"
            android:textColor="#B3CFC8FF"
            android:fontFamily="@font/plus_jakarta_sans_semibold"
            android:visibility="gone" />
    </LinearLayout>

    <ImageView
        android:id="@+id/thumbImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/cd_logo"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_scrim_top" />
</merge>
