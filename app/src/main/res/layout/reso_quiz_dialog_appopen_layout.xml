<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/reso__ll_continue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/reso_bg_header_appopen"
        android:backgroundTint="@color/white"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="10dp">

        <ImageView
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:fontFamily="@font/plus_jakarta_sans_medium"
            android:text="Continue to app"
            android:textColor="@color/black" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginLeft="10dp"
            android:src="@drawable/plts_right_arrow"
            app:tint="@color/black" />

    </LinearLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/reso__ll_continue"
        android:background="@color/white"
        android:orientation="vertical">

        <TextView
            android:id="@+id/reso__tv_advertisement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:fontFamily="@font/plus_jakarta_sans_medium"
            android:gravity="center"
            android:text="Advertisement"
            android:textColor="@color/black"
            android:textSize="@dimen/_11sdp" />

        <RelativeLayout
            android:id="@+id/reso__rl_qureka"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/reso__tv_advertisement"
            android:layout_marginStart="5dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="5dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/reso_quiz_app_open_bg">

            <ImageView
                android:id="@+id/reso__inter_quiz"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/reso__btn_playnow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_marginHorizontal="@dimen/_10sdp"
                android:layout_marginLeft="@dimen/_4sdp"
                android:layout_marginBottom="@dimen/_5sdp"
                android:background="@drawable/bg_button_primary"
                android:backgroundTint="@color/color_primary"
                android:fontFamily="@font/plus_jakarta_sans_medium"
                android:paddingVertical="@dimen/_11sdp"
                android:text="Start Video Call"
                android:textAlignment="center"
                android:includeFontPadding="false"
                android:textColor="@color/white"
                android:textSize="16sp" />

        </RelativeLayout>
    </RelativeLayout>
</RelativeLayout>