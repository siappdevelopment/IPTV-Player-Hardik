<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/_5sdp"
    android:layout_marginTop="@dimen/_4sdp"
    android:layout_marginEnd="@dimen/_5sdp"
    android:layout_marginBottom="@dimen/_4sdp"
    android:background="@drawable/bg_card_small"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/_6sdp"
    android:paddingTop="@dimen/_6sdp"
    android:paddingEnd="@dimen/_3sdp"
    android:paddingBottom="@dimen/_6sdp">

    <FrameLayout
        android:layout_width="@dimen/_55sdp"
        android:layout_height="@dimen/_55sdp"
        android:background="@drawable/bg_thumb_15"
        android:clipToOutline="true">

        <com.iptvplayer.xtreamiptv.myiptvpro.IPTV.ui.common.ChannelThumbView
            android:id="@+id/thumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#590B0D16" />

        <FrameLayout
            android:layout_width="@dimen/_27sdp"
            android:layout_height="@dimen/_27sdp"
            android:layout_gravity="center"
            android:background="@drawable/bg_gradient_12">

            <ImageView
                android:id="@+id/ivIcon"
                android:layout_width="@dimen/_15sdp"
                android:layout_height="@dimen/_15sdp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_video_library"
                app:tint="@color/white" />
        </FrameLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_9sdp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvName"
            style="@style/Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="@dimen/_12sdp"
            android:fontFamily="@font/plus_jakarta_sans_semibold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_2sdp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCount"
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/_10sdp" />

            <View
                android:layout_width="@dimen/_2sdp"
                android:layout_height="@dimen/_2sdp"
                android:layout_marginStart="@dimen/_6sdp"
                android:layout_marginEnd="@dimen/_6sdp"
                android:background="@drawable/bg_dot_sep" />

            <TextView
                android:id="@+id/tvSource"
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="@dimen/_3sdp"
                android:drawableTint="@color/color_accent_light"
                android:gravity="center_vertical"
                android:textColor="@color/color_accent_light"
                android:textSize="@dimen/_10sdp" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/btnEdit"
        style="@style/IconButton.Plain"
        android:contentDescription="@string/cd_edit_playlist"
        android:src="@drawable/ic_edit"
        app:tint="@color/color_text_soft" />

    <ImageView
        android:id="@+id/btnDelete"
        style="@style/IconButton.Plain"
        android:contentDescription="@string/cd_delete_playlist"
        android:src="@drawable/ic_delete"
        app:tint="@color/color_error_soft" />
</LinearLayout>
