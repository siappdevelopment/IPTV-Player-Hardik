<?xml version="1.0" encoding="utf-8"?>
<!-- Design "About": 24 card, padding 26/22/22, 72 logo tile, stats list, 1fr / 1.4fr buttons. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="@dimen/_22sdp"
    android:paddingTop="@dimen/_26sdp"
    android:paddingEnd="@dimen/_22sdp"
    android:paddingBottom="@dimen/_22sdp">

    <FrameLayout
        android:layout_width="@dimen/_72sdp"
        android:layout_height="@dimen/_72sdp"
        android:background="@drawable/bg_gradient_tile_24">

        <ImageView
            android:layout_width="@dimen/_38sdp"
            android:layout_height="@dimen/_38sdp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_live_tv"
            app:tint="@color/white" />
    </FrameLayout>

    <TextView
        style="@style/Text.Semibold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_14sdp"
        android:text="@string/brand_name"
        android:textSize="@dimen/_20sdp" />

    <TextView
        android:id="@+id/tvVersion"
        style="@style/Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_6sdp"
        android:textColor="@color/color_text_secondary"
        android:textSize="@dimen/_13_5sdp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_14sdp"
        android:background="@drawable/bg_tile_raised_16"
        android:orientation="vertical">

        <include
            android:id="@+id/rowPlaylists"
            layout="@layout/item_about_stat" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/_1sdp"
            android:layout_marginStart="@dimen/_14sdp"
            android:layout_marginEnd="@dimen/_14sdp"
            android:background="@color/color_divider_card" />

        <include
            android:id="@+id/rowChannels"
            layout="@layout/item_about_stat" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/_1sdp"
            android:layout_marginStart="@dimen/_14sdp"
            android:layout_marginEnd="@dimen/_14sdp"
            android:background="@color/color_divider_card" />

        <include
            android:id="@+id/rowUpdates"
            layout="@layout/item_about_stat" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_14sdp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnClose"
            style="@style/Button.Secondary"
            android:layout_width="@dimen/_0sdp"
            android:layout_height="@dimen/_52sdp"
            android:layout_weight="1"
            android:minHeight="@dimen/_52sdp"
            android:paddingStart="@dimen/_0sdp"
            android:paddingEnd="@dimen/_0sdp"
            android:text="@string/action_close" />

        <TextView
            android:id="@+id/btnCheck"
            style="@style/Button.Primary"
            android:layout_width="@dimen/_0sdp"
            android:layout_height="@dimen/_52sdp"
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_weight="1.4"
            android:drawablePadding="@dimen/_8sdp"
            android:minHeight="@dimen/_52sdp"
            android:paddingStart="@dimen/_0sdp"
            android:paddingEnd="@dimen/_0sdp"
            android:text="@string/about_check_updates" />
    </LinearLayout>
</LinearLayout>
