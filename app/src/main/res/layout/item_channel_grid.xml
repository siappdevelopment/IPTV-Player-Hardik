<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/_6sdp"
    android:background="@drawable/bg_card_small"
    android:clickable="true"
    android:focusable="true">

    <com.iptvplayer.xtreamiptv.myiptvpro.ui.common.ChannelThumbView
        android:id="@+id/thumb"
        android:layout_width="@dimen/_0sdp"
        android:layout_height="@dimen/_0sdp"
        android:layout_margin="@dimen/_6sdp"
        android:background="@drawable/bg_thumb_15"
        app:layout_constraintDimensionRatio="16:9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tileIconSize="@dimen/_26sdp"
        app:tileSize="@dimen/_46sdp" />

    <TextView
        android:id="@+id/tvQuality"
        style="@style/Text"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/_22sdp"
        android:layout_marginStart="@dimen/_8sdp"
        android:layout_marginTop="@dimen/_8sdp"
        android:background="@drawable/bg_badge_small"
        android:gravity="center_vertical"
        android:letterSpacing="0.02"
        android:paddingStart="@dimen/_7sdp"
        android:paddingEnd="@dimen/_7sdp"
        android:textSize="@dimen/_11sdp"
        android:fontFamily="@font/plus_jakarta_sans_semibold"
        app:layout_constraintStart_toStartOf="@id/thumb"
        app:layout_constraintTop_toTopOf="@id/thumb" />

    <ImageView
        android:id="@+id/btnFavorite"
        android:layout_width="@dimen/_36sdp"
        android:layout_height="@dimen/_36sdp"
        android:layout_marginTop="@dimen/_5sdp"
        android:layout_marginEnd="@dimen/_5sdp"
        android:background="@drawable/bg_circle_dim"
        android:contentDescription="@string/cd_favorite"
        android:padding="@dimen/_8sdp"
        android:src="@drawable/sel_favorite"
        app:layout_constraintEnd_toEndOf="@id/thumb"
        app:layout_constraintTop_toTopOf="@id/thumb"
        app:tint="@color/selector_fav_tint" />

    <TextView
        android:id="@+id/tvName"
        style="@style/Text"
        android:layout_width="@dimen/_0sdp"
        android:layout_height="@dimen/_22sdp"
        android:gravity="center_vertical"
        android:layout_marginStart="@dimen/_12sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_marginEnd="@dimen/_12sdp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textSize="@dimen/_15sdp"
        android:fontFamily="@font/plus_jakarta_sans_semibold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/thumb" />

    <TextView
        android:id="@+id/tvCategories"
        style="@style/Text.Caption"
        android:layout_width="@dimen/_0sdp"
        android:layout_height="@dimen/_18sdp"
        android:gravity="center_vertical"
        android:layout_marginStart="@dimen/_12sdp"
        android:layout_marginTop="@dimen/_3sdp"
        android:layout_marginEnd="@dimen/_12sdp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textSize="@dimen/_12_5sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvName" />

    <TextView
        android:id="@+id/tvWatched"
        style="@style/Text.Caption"
        android:layout_width="@dimen/_0sdp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_12sdp"
        android:layout_marginTop="@dimen/_2sdp"
        android:layout_marginEnd="@dimen/_12sdp"
        android:drawableStart="@drawable/ic_history"
        android:drawablePadding="@dimen/_4sdp"
        android:drawableTint="@color/color_accent_light"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:textColor="@color/color_accent_light"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvCategories" />

    <ImageView
        android:id="@+id/btnMore"
        android:layout_width="@dimen/_40sdp"
        android:layout_height="@dimen/_40sdp"
        android:layout_marginStart="@dimen/_12sdp"
        android:layout_marginTop="@dimen/_8sdp"
        android:layout_marginBottom="@dimen/_12sdp"
        android:background="@drawable/bg_more_button"
        android:contentDescription="@string/cd_more_actions"
        android:padding="@dimen/_10sdp"
        android:src="@drawable/ic_more_horiz"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvWatched"
        app:tint="@color/color_text_soft" />

    <ImageView
        android:id="@+id/btnOpen"
        android:layout_width="@dimen/_40sdp"
        android:layout_height="@dimen/_40sdp"
        android:layout_marginEnd="@dimen/_12sdp"
        android:background="@drawable/bg_explore_pill"
        android:contentDescription="@string/action_explore"
        android:padding="@dimen/_9sdp"
        android:src="@drawable/ic_chevron_right"
        app:layout_constraintBottom_toBottomOf="@id/btnMore"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnMore"
        app:tint="@color/color_accent_light" />
</androidx.constraintlayout.widget.ConstraintLayout>
