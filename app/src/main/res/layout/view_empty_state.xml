<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="@dimen/_21sdp"
    android:paddingTop="@dimen/spacing_xl"
    android:paddingEnd="@dimen/_21sdp">

    <ImageView
        android:id="@+id/ivEmptyIcon"
        android:layout_width="@dimen/_180sdp"
        android:layout_height="@dimen/_115sdp"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_no_data" />

    <TextView
        android:id="@+id/tvEmptyTitle"
        style="@style/Text.Headline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center" />

    <TextView
        android:id="@+id/tvEmptyDesc"
        style="@style/Text.Body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:gravity="center"
        android:maxWidth="@dimen/_214sdp"
        android:textColor="@color/color_text_secondary"
        app:lineHeight="@dimen/_17sdp" />

    <TextView
        android:id="@+id/btnEmptyPrimary"
        style="@style/Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_marginTop="@dimen/spacing_lg"
        android:drawableEnd="@drawable/ic_add"
        android:drawableTint="@color/white"
        android:visibility="gone" />

    <TextView
        android:id="@+id/btnEmptyPill"
        style="@style/Button.Secondary"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/_40sdp"
        android:layout_marginTop="@dimen/spacing_lg"
        android:drawableEnd="@drawable/ic_arrow_forward"
        android:drawableTint="@color/color_accent_light"
        android:textSize="@dimen/_11sdp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/rowEmptyShortcuts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/btnShortcutUrl"
            style="@style/Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="@dimen/_40sdp"
            android:layout_weight="1"
            android:drawableStart="@drawable/ic_link"
            android:drawableTint="@color/color_accent_light"
            android:paddingStart="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_md"
            android:text="@string/empty_playlist_import_url"
            android:textSize="@dimen/_11sdp" />

        <TextView
            android:id="@+id/btnShortcutFile"
            style="@style/Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="@dimen/_40sdp"
            android:layout_marginStart="@dimen/_8sdp"
            android:layout_weight="1"
            android:drawableStart="@drawable/ic_upload_file"
            android:drawableTint="@color/color_accent_light"
            android:paddingStart="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_md"
            android:text="@string/empty_playlist_upload"
            android:textSize="@dimen/_11sdp" />
    </LinearLayout>
</LinearLayout>
