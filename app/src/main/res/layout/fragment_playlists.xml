<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/spacing_sm"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/list_bottom_padding">

        <!-- search + settings -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnSearch"
                style="@style/Text.Body"
                android:layout_width="@dimen/_0sdp"
                android:layout_height="@dimen/circle_button"
                android:layout_weight="1"
                android:background="@drawable/bg_search_pill_button"
                android:clickable="true"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="@dimen/_10sdp"
                android:drawableTint="@color/color_text_secondary"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/_18sdp"
                android:paddingEnd="@dimen/_18sdp"
                android:text="@string/home_search_hint"
                android:textColor="@color/color_text_secondary" />

            <ImageView
                android:id="@+id/btnSettings"
                style="@style/IconButton.Large"
                android:layout_marginStart="@dimen/_12sdp"
                android:contentDescription="@string/cd_settings"
                android:src="@drawable/ic_settings"
                app:tint="@color/color_text_primary" />
        </LinearLayout>

        <!-- banner -->
        <FrameLayout
            android:id="@+id/banner"
            android:layout_width="match_parent"
            android:layout_height="@dimen/banner_height"
            android:layout_marginTop="@dimen/_22sdp"
            android:background="@drawable/bg_banner"
            android:clipToOutline="true">

            <FrameLayout
                android:id="@+id/bannerCollage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:layout_marginStart="@dimen/_134sdp"
                android:layout_marginEnd="@dimen/_minus14sdp"
                android:padding="@dimen/_6sdp" />

            <View
                android:id="@+id/bannerFade"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/_20sdp"
                android:gravity="center_vertical"
                android:maxWidth="@dimen/_230sdp"
                android:orientation="vertical">

                <TextView
                    style="@style/Text"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/_24sdp"
                    android:background="@drawable/bg_banner_badge"
                    android:drawableStart="@drawable/bg_dot_live"
                    android:drawablePadding="@dimen/_6sdp"
                    android:gravity="center_vertical"
                    android:letterSpacing="0.06"
                    android:paddingStart="@dimen/_9sdp"
                    android:paddingEnd="@dimen/_9sdp"
                    android:text="@string/banner_badge"
                    android:textColor="@color/color_accent_soft"
                    android:textSize="@dimen/_11sdp"
                    android:fontFamily="@font/plus_jakarta_sans_semibold" />

                <TextView
                    style="@style/Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_6sdp"
                    android:letterSpacing="-0.02"
                    android:text="@string/banner_title"
                    android:textSize="@dimen/_26sdp"
                    android:fontFamily="@font/plus_jakarta_sans_semibold" />

                <TextView
                    style="@style/Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_6sdp"
                    android:text="@string/brand_tagline"
                    android:textColor="@color/color_text_soft"
                    android:textSize="@dimen/_15sdp" />

                <TextView
                    android:id="@+id/tvBannerStats"
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:textSize="@dimen/_12_5sdp" />
            </LinearLayout>
        </FrameLayout>

        <!-- section header -->
        <LinearLayout
            android:id="@+id/sectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_22sdp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="@dimen/_0sdp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_your_playlists" />

                <TextView
                    android:id="@+id/tvPlaylistCount"
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:textSize="@dimen/_13sdp" />
            </LinearLayout>

            <include
                android:id="@+id/viewToggle"
                layout="@layout/view_view_toggle" />
        </LinearLayout>

        <!-- filter chips -->
        <LinearLayout
            android:id="@+id/filterRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_14sdp"
            android:orientation="horizontal">

            <include
                android:id="@+id/chipAll"
                layout="@layout/item_category_chip" />

            <include
                android:id="@+id/chipUrl"
                layout="@layout/item_category_chip" />

            <include
                android:id="@+id/chipFile"
                layout="@layout/item_category_chip" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPlaylists"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_minus6sdp"
            android:layout_marginTop="@dimen/spacing_md"
            android:layout_marginEnd="@dimen/_minus6sdp"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never" />

        <!-- first-run empty state -->
        <include
            android:id="@+id/emptyAll"
            layout="@layout/view_empty_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_minus28sdp"
            android:layout_marginEnd="@dimen/_minus28sdp"
            android:visibility="gone" />

        <!-- default playlists are being added -->
        <LinearLayout
            android:id="@+id/viewSeeding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_60sdp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="@dimen/_40sdp"
                android:layout_height="@dimen/_40sdp"
                android:indeterminate="true"
                android:indeterminateTint="@color/color_accent_light" />

            <TextView
                style="@style/Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_16sdp"
                android:text="@string/seeding_title" />

            <TextView
                style="@style/Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:gravity="center"
                android:text="@string/seeding_desc"
                android:textColor="@color/color_text_secondary" />
        </LinearLayout>

        <!-- filter has no matches -->
        <LinearLayout
            android:id="@+id/emptyFilter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:background="@drawable/bg_dashed_empty"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/_20sdp"
            android:paddingTop="@dimen/_28sdp"
            android:paddingEnd="@dimen/_20sdp"
            android:paddingBottom="@dimen/_28sdp"
            android:visibility="gone">

            <ImageView
                android:layout_width="@dimen/_150sdp"
                android:layout_height="@dimen/_95sdp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_no_data" />

            <TextView
                android:id="@+id/tvEmptyFilterTitle"
                style="@style/Text.BodyStrong"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:textSize="@dimen/_16sdp" />

            <TextView
                style="@style/Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_6sdp"
                android:gravity="center"
                android:text="@string/empty_filter_desc"
                android:textSize="@dimen/_13_5sdp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
