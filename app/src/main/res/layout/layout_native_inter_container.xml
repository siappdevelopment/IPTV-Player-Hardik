<?xml version="1.0" encoding="utf-8"?>
<com.iptvplayer.xtreamiptv.myiptvpro.Main.adsmanege.NativeConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#141827">

    <FrameLayout
        android:id="@+id/viewGroup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <androidx.cardview.widget.CardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        app:cardBackgroundColor="#66828282"
        app:cardCornerRadius="99dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/ad_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/ad_close"
        app:layout_constraintTop_toTopOf="parent">

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="3dp">

            <ImageView
                android:id="@+id/ad_close"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:src="@drawable/ic_close"
                android:visibility="gone" />

            <TextView
                android:id="@+id/ad_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:text="5"
                android:fontFamily="@font/plus_jakarta_sans_medium"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:visibility="gone" />
        </RelativeLayout>
    </androidx.cardview.widget.CardView>

</com.iptvplayer.xtreamiptv.myiptvpro.Main.adsmanege.NativeConstraintLayout>
