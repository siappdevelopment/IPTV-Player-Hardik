<?xml version="1.0" encoding="utf-8"?>
<!-- HTML "Refresh playlists": 24px card, 22px padding, 14px gaps. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical"
    android:padding="@dimen/_22sdp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/tileIcon"
            android:layout_width="@dimen/_48sdp"
            android:layout_height="@dimen/_48sdp"
            android:background="@drawable/bg_tile_high_16">

            <ImageView
                android:id="@+id/ivIcon"
                android:layout_width="@dimen/_26sdp"
                android:layout_height="@dimen/_26sdp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_sync"
                app:tint="@color/color_accent_light" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="@dimen/_0sdp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_14sdp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTitle"
                style="@style/Text.Semibold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/_19sdp" />

            <TextView
                android:id="@+id/tvSub"
                style="@style/Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:textColor="@color/color_text_secondary"
                android:textSize="@dimen/_13_5sdp" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_6sdp"
        android:layout_marginTop="@dimen/_14sdp"
        android:max="100"
        android:progressDrawable="@drawable/progress_refresh" />

    <LinearLayout
        android:id="@+id/llRows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_14sdp"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/btnAction"
        style="@style/Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_52sdp"
        android:layout_marginTop="@dimen/_14sdp"
        android:minHeight="@dimen/_52sdp" />
</LinearLayout>
