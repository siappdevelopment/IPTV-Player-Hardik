<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="@dimen/_14sdp"
    android:paddingBottom="@dimen/spacing_sm">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvName"
                style="@style/Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:letterSpacing="-0.01"
                android:maxLines="1"
                android:textSize="@dimen/_17sdp"
                android:fontFamily="@font/plus_jakarta_sans_semibold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvStatus"
                    style="@style/Text"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/_18sdp"
                    android:background="@drawable/bg_status_chip"
                    android:drawableStart="@drawable/bg_dot_status"
                    android:drawablePadding="@dimen/_4sdp"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/_6sdp"
                    android:paddingEnd="@dimen/_6sdp"
                    android:textSize="@dimen/_9sdp"
                    android:fontFamily="@font/plus_jakarta_sans_semibold" />

                <TextView
                    android:id="@+id/tvQuality"
                    style="@style/Text"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/_18sdp"
                    android:layout_marginStart="@dimen/_6sdp"
                    android:background="@drawable/bg_status_chip"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/_6sdp"
                    android:paddingEnd="@dimen/_6sdp"
                    android:textSize="@dimen/_9sdp"
                    android:fontFamily="@font/plus_jakarta_sans_semibold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvCategories"
                style="@style/Text.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:ellipsize="end"
                android:maxLines="1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnFavorite"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_37sdp"
            android:layout_marginStart="@dimen/_11sdp"
            android:background="@drawable/bg_search_pill_button_14"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="@dimen/_11sdp"
            android:paddingEnd="@dimen/_11sdp">

            <ImageView
                android:id="@+id/ivFavorite"
                android:layout_width="@dimen/_15sdp"
                android:layout_height="@dimen/_15sdp"
                android:layout_marginEnd="@dimen/_5sdp"
                android:duplicateParentState="true"
                android:importantForAccessibility="no"
                android:src="@drawable/sel_favorite"
                app:tint="@color/selector_fav_tint" />

            <TextView
                android:id="@+id/tvFavorite"
                style="@style/Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:duplicateParentState="true"
                android:fontFamily="@font/plus_jakarta_sans_semibold"
                android:text="@string/player_favorite"
                android:textSize="@dimen/_11sdp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_12sdp"
        android:gravity="bottom"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvListTitle"
            style="@style/Text.Subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tvListCount"
            style="@style/Text.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>
