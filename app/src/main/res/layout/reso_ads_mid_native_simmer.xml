<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/reso__linear_full"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_5sdp"
        android:background="@drawable/reso_ads_main_bg"
        android:orientation="vertical"
        android:visibility="visible">

        <io.supercharge.shimmerlayout.ShimmerLayout
            android:id="@+id/reso__shimmer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            app:shimmer_animation_duration="1000">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:background="#AAA8A8"
                        android:gravity="center">

                        <com.google.android.gms.ads.nativead.MediaView
                            android:id="@+id/reso__media_view"
                            android:layout_width="180dp"
                            android:layout_height="122dp"
                            android:layout_gravity="top|center_horizontal"
                            android:layout_marginTop="5dp"
                            android:backgroundTint="#AAA8A8" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/_5sdp"
                        android:layout_weight="0.5"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="#AAA8A8"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/reso__logo"
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:adjustViewBounds="true" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginStart="@dimen/_5sdp"
                                android:background="@drawable/reso_ad_all_bg"
                                android:fontFamily="@font/plus_jakarta_sans_medium"
                                android:paddingLeft="5dp"
                                android:paddingVertical="5dp"
                                android:paddingRight="5dp"
                                android:text="Ad"
                                android:textColor="@color/white"
                                android:textSize="11dp" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/reso__top_line"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_2sdp"
                            android:fontFamily="@font/plus_jakarta_sans_medium"
                            android:lines="1"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:textColor="@color/white"
                            android:textSize="@dimen/_11sdp" />

                        <TextView
                            android:id="@+id/reso__body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_1sdp"
                            android:background="#AAA8A8"
                            android:ellipsize="end"
                            android:fontFamily="@font/plus_jakarta_sans_regular"
                            android:lines="2"
                            android:maxLines="2"
                            android:textColor="@color/browser_actions_bg_grey"
                            android:textSize="@dimen/_11sdp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/reso__advertisment"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:gravity="bottom"
                                android:fontFamily="@font/plus_jakarta_sans_regular"
                                android:singleLine="true"
                                android:textColor="@color/white"
                                android:textSize="12sp"
                                android:visibility="gone" />

                            <RatingBar
                                android:id="@+id/reso__rate_stars"
                                style="?android:attr/ratingBarStyleSmall"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:isIndicator="true"
                                android:numStars="5"
                                android:stepSize="0.5"
                                android:visibility="gone" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="10dp"
                                android:layout_weight="1"
                                android:gravity="end"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/reso__fees"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:paddingStart="5dp"
                                    android:paddingLeft="5dp"
                                    android:paddingEnd="5dp"
                                    android:paddingRight="5dp"
                                    android:fontFamily="@font/plus_jakarta_sans_regular"
                                    android:singleLine="true"
                                    android:textColor="@color/white"
                                    android:textSize="12sp" />

                                <TextView
                                    android:id="@+id/reso__store"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:paddingStart="5dp"
                                    android:paddingLeft="5dp"
                                    android:fontFamily="@font/plus_jakarta_sans_regular"
                                    android:paddingEnd="5dp"
                                    android:paddingRight="5dp"
                                    android:singleLine="true"
                                    android:textColor="@color/white"
                                    android:textSize="12sp" />

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_5sdp"
                    android:layout_marginVertical="@dimen/_4sdp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/reso__install_button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_button_primary"
                        android:backgroundTint="#AAA8A8"
                        android:fontFamily="@font/plus_jakarta_sans_medium"
                        android:gravity="center"
                        android:padding="11dp"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_14sdp" />

                </LinearLayout>

            </LinearLayout>

        </io.supercharge.shimmerlayout.ShimmerLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/reso__linear_Native_big"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_5sdp"
        android:orientation="vertical"
        android:visibility="gone" />

</LinearLayout>